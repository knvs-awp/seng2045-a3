# Copy to .env.local. Add the same values in Vercel's Environment Variables.
DJANGO_SECRET_KEY=

# Supabase Dashboard > Connect > Transaction pooler connection URI.
# Replace the password placeholder with your project's database password.
DATABASE_URL=

# Supabase project URL, e.g. https://your-project.supabase.co
SUPABASE_URL=

# Supabase Storage > S3 configuration. These are S3 credentials, not API keys.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=
SUPABASE_STORAGE_BUCKET=media

# Create a public bucket named media and upload src/media/avatar.png as avatar.png.
